# Copier en .env (gitignoré) pour surcharger les valeurs par défaut de docker-compose.yml.

# Mots de passe de la base (réseau interne à Docker, jamais publiée). Lettres et chiffres
# uniquement : ils sont insérés tels quels dans une URL de connexion. Ils ne sont lus qu'à la
# création du volume : pour les changer ensuite, `docker compose down -v` (efface les données).
POSTGRES_PASSWORD=lastslotadmindev
APP_DB_PASSWORD=lastslotappdev

# Port local de l'application : http://localhost:8000
API_PORT=8000

# Adresse utilisée dans les liens commerçants du seed (à adapter derrière Tailscale ou Traefik).
PUBLIC_BASE_URL=http://localhost:8000

# Durée de blocage d'une place avant paiement (secondes) et commission Last Slot (%).
HOLD_SECONDS=300
COMMISSION_PCT=15

# Option Traefik (docker-compose.traefik.yml) :
# LASTSLOT_HOST=lastslot.maison.lan
# TRAEFIK_NETWORK=traefik
# TRAEFIK_ENTRYPOINT=websecure
